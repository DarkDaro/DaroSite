# Текстовые файлы: единые LF, без сюрпризов CRLF между машинами
* text=auto eol=lf

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Бинарные ассеты: не нормализовать и не пытаться сравнивать как текст
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
